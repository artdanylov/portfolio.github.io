---
import contactData from '../content/settings/contact.json';
import homeData from '../content/settings/home.json';

interface Props {
  title: string;
  description?: string;
  image?: string;
  preloadImage?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  activeNav?: 'home' | 'portfolio' | 'blog' | 'contact';
  bodyClass?: string;
}

const DEFAULT_DESCRIPTION =
  'Artem Danylov — 3D animator, character rigger, and technical artist specializing in Maya, Unreal Engine, mocap, and game cinematics.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  preloadImage,
  ogType = 'website',
  noIndex = false,
  activeNav,
  bodyClass = '',
} = Astro.props;

const siteOrigin = (Astro.site?.toString() || 'https://artdanylov.com').replace(/\/$/, '');
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath === '/index.html' ? '/' : rawPath;
const canonicalUrl = `${siteOrigin}${normalizedPath}`;

const ogImage = image
  ? /^https?:\/\//i.test(image)
    ? image
    : `${siteOrigin}${image.startsWith('/') ? '' : '/'}${image}`
  : undefined;

const sameAs = [
  contactData.linkedin?.url,
  contactData.artstation?.url,
  contactData.instagram?.url,
].filter((url): url is string => Boolean(url && /^https?:\/\//i.test(url)));

const MULTILINGUAL_KEYWORDS = [
  'Artem Danylov',
  'ArtDanylov',
  'Артем Данилов',
  'Артём Данилов',
  'Артем Данілов',
  '3D animator',
  'character rigger',
  'technical animator',
  'game cinematics',
  '3D аніматор',
  '3D анімація',
  'ріггінг персонажів',
  'ігрові синематики',
  '3D аниматор',
  '3D анимация',
  'риггинг персонажей',
  'техническая анимация',
  'игровые синематики',
  '3D animácia',
  'rigging postáv',
  'herná animácia',
  '3D Animation Deutschland',
  'Character Rigging',
  '3D animace',
  'rigging postav',
  'animacja 3D',
  'rigging postaci',
  'Maya',
  'Unreal Engine',
  'mGear',
  'mocap',
  'мокап',
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Artem Danylov',
  alternateName: ['ArtDanylov', 'Артем Данилов', 'Артём Данилов', 'Артем Данілов'],
  url: `${siteOrigin}/`,
  jobTitle: '3D Animator & Character Rigger',
  description:
    'Artem Danylov — 3D animator & character rigger (Maya, Unreal Engine, mocap) working with studios across Slovakia, Germany, Czechia, Poland, and worldwide.',
  knowsLanguage: ['en', 'uk', 'ru'],
  areaServed: [
    { '@type': 'Country', name: 'Slovakia' },
    { '@type': 'Country', name: 'Germany' },
    { '@type': 'Country', name: 'Czechia' },
    { '@type': 'Country', name: 'Poland' },
    { '@type': 'AdministrativeArea', name: 'European Union' },
  ],
  knowsAbout: Array.from(
    new Set([
      ...(homeData.marqueeItems || []),
      '3D анімація',
      'Ріггінг персонажів',
      'Технічна анімація',
      'Ігрові синематики',
      '3D анимация',
      'Риггинг персонажей',
      'Техническая анимация',
      'Игровые синематики',
      'Мокап',
      '3D animácia',
      'Rigging postáv',
      '3D Animation',
      '3D animace',
      'Animacja 3D',
      'Rigging postaci',
    ])
  ),
  sameAs,
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={MULTILINGUAL_KEYWORDS.join(', ')} />
    {noIndex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}

    <meta property="og:site_name" content="ArtDanylov" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="uk_UA" />
    <meta property="og:locale:alternate" content="ru_RU" />
    <meta property="og:locale:alternate" content="sk_SK" />
    <meta property="og:locale:alternate" content="de_DE" />
    <meta property="og:locale:alternate" content="cs_CZ" />
    <meta property="og:locale:alternate" content="pl_PL" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="ArtDanylov RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://media.artdanylov.com" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="/assets/css/base.css" />
    <link rel="stylesheet" href="/assets/css/styles.min.css" />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@200..900&family=Space+Grotesk:wght@300..700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@200..900&family=Space+Grotesk:wght@300..700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@200..900&family=Space+Grotesk:wght@300..700&display=swap"
      />
    </noscript>
  </head>
  <body class={bodyClass}>
    <slot name="before-nav" />

    <nav class="site-nav">
      <div class="wrap-fluid site-nav-inner">
        <a class="site-brand" href="/">Artem Danylov</a>
        <button
          class="site-nav-toggle"
          data-nav-toggle
          data-nav-target="#mainNav"
          type="button"
          aria-controls="mainNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="site-nav-toggle-icon"></span>
        </button>
        <div class="site-nav-menu" id="mainNav">
          <ul class="site-nav-list">
            <li class="site-nav-item">
              <a class={`site-nav-link${activeNav === 'home' ? ' is-active' : ''}`} href="/index.html">Home</a>
            </li>
            <li class="site-nav-item">
              <a class={`site-nav-link${activeNav === 'portfolio' ? ' is-active' : ''}`} href="/portfolio.html">Portfolio</a>
            </li>
            <li class="site-nav-item">
              <a class={`site-nav-link${activeNav === 'blog' ? ' is-active' : ''}`} href="/blog.html">Blog</a>
            </li>
            <li class="site-nav-item">
              <a class={`site-nav-link${activeNav === 'contact' ? ' is-active' : ''}`} href="/contact.html">Contact</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="site-footer">
      <div class="wrap-fluid wrap-padded">
        <div class="site-footer-row">
          <div class="footer-actions">
            <p class="footer-copy">© {new Date().getFullYear()} ArtDanylov</p>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline defer src="/assets/js/script.min.js"></script>
  </body>
</html>
