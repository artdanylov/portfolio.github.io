---
import { toVimeoEmbed } from '../utils/embed';

interface Props {
  src: string;
  title?: string;
}

const { src, title = 'Vimeo video' } = Astro.props;
---

<div class="rounded-4 overflow-hidden ratio ratio-16x9 mt-4 mb-4">
  <iframe
    src={toVimeoEmbed(src)}
    title={title}
    allow="autoplay; fullscreen; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>
