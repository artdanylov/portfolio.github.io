---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found - ArtDanylov" bodyClass="page-404-body" noIndex={true}>
  <section class="page-404-main">
    <div class="wrap">
      <div class="wrap-centered text-center">
        <p class="section-tag">Error 404</p>
        <h1 class="page-hero-title">Page not found.</h1>
        <p class="text-muted page-404-copy">
          The page you're looking for doesn't exist or has moved. Head back home or check out the portfolio.
        </p>
        <div class="page-404-actions">
          <a class="button button-primary button-lg button-wide" role="button" href="/">Back to Home</a>
          <a class="button button-ghost button-lg button-wide" role="button" href="/portfolio.html">View Portfolio</a>
        </div>
        <p class="text-muted page-404-foot">
          Think something's broken? <a href="/contact.html">Let us know</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
