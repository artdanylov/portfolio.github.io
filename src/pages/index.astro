---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveMediaUrl, resolveVideoPosterUrl } from '../utils/media';
import homeData from '../content/settings/home.json';

const reelVideoPath = homeData.reelVideo || 'portfolio/portfolio.mp4';
const reelVideoUrl = resolveMediaUrl(reelVideoPath, 'video');
const reelPosterUrl = resolveVideoPosterUrl(homeData.reelPoster, reelVideoPath);
---

<BaseLayout
  title="Home - ArtDanylov"
  activeNav="home"
  bodyClass="has-page-video"
  image={reelPosterUrl || undefined}
  preloadImage={reelPosterUrl || undefined}
>
  <Fragment slot="before-nav">
    <div class="page-video-bg" aria-hidden="true">
      {reelPosterUrl && (
        <img
          class="page-video-poster"
          src={reelPosterUrl}
          alt=""
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="sync"
          onerror="this.style.display='none'"
        />
      )}
      <video
        id="bgVideo"
        class="page-video"
        src={reelPosterUrl ? undefined : reelVideoUrl}
        data-src={reelPosterUrl ? reelVideoUrl : undefined}
        autoplay={!reelPosterUrl || undefined}
        muted
        loop
        playsinline
        preload={reelPosterUrl ? 'none' : 'metadata'}
        tabindex="-1"
        aria-hidden="true"
        disablepictureinpicture
      ></video>
    </div>
    <div class="page-video-scrim" aria-hidden="true"></div>
    <div class="page-vignette" aria-hidden="true"></div>
    <div class="page-crt" aria-hidden="true"></div>
  </Fragment>

  <section class="hero-section">
    <div class="wrap-fluid wrap-padded hero-inner">
      <h1 class="hero-title-main page-hero-title hero-display-title text-gradient-brand hero-anim">
        {homeData.heroTitle}
      </h1>
      <p class="hero-copy copy-wide text-muted hero-anim hero-anim-delay-1">
        <strong class="hero-lead-strong">{homeData.heroLeadBold}</strong>&nbsp;{homeData.heroLeadRest}
      </p>
      <div class="hero-actions hero-anim hero-anim-delay-2">
        <a class="button button-primary button-lg" id="reelTrigger" role="button" href="#reel">{homeData.reelButtonLabel}</a>
      </div>
    </div>

    <section id="reel" class="reel-section" aria-hidden="true">
      <div class="reel-shell">
        <div class="reel-player" id="reelTarget"></div>
      </div>
    </section>
  </section>

  <div class="marquee-wrapper" data-marquee-direction="left" data-marquee-pause="true">
    <div class="marquee-track">
      {homeData.marqueeItems.map((item) => (
        <>
          <span>{item}</span><span class="text-accent">•</span>
        </>
      ))}
    </div>
  </div>
</BaseLayout>
