---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveMediaUrl, resolveThumbnailUrls } from '../utils/media';
import homeData from '../content/settings/home.json';

const reelVideoUrl = resolveMediaUrl(homeData.reelVideo || 'portfolio/portfolio.mp4', 'video');
const reelPosterUrl = homeData.reelPoster
  ? resolveThumbnailUrls(homeData.reelPoster).staticUrl
  : '';
---

<BaseLayout
  title="Home - ArtDanylov"
  activeNav="home"
  bodyClass="has-page-video"
  image={reelPosterUrl || undefined}
  preloadImage={reelPosterUrl || undefined}
>
  <Fragment slot="before-nav">
    <div class="page-video-bg" aria-hidden="true">
      <video
        id="bgVideo"
        class="page-video"
        src={reelVideoUrl}
        poster={reelPosterUrl || undefined}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        tabindex="-1"
        aria-hidden="true"
        disablepictureinpicture
      ></video>
    </div>
    <div class="page-video-scrim" aria-hidden="true"></div>
    <div class="page-vignette" aria-hidden="true"></div>
    <div class="page-crt" aria-hidden="true"></div>
  </Fragment>

  <section class="hero-section">
    <div class="wrap-fluid wrap-padded hero-inner">
      <h1
        class="hero-title-main page-hero-title hero-display-title text-gradient-brand"
        data-aos="fade-up"
        data-aos-duration="1000"
      >
        {homeData.heroTitle}
      </h1>
      <p
        class="hero-copy copy-wide text-muted"
        data-aos="fade-up"
        data-aos-duration="800"
        data-aos-delay="700"
      >
        <strong class="hero-lead-strong">{homeData.heroLeadBold}</strong>&nbsp;{homeData.heroLeadRest}
      </p>
      <div
        class="hero-actions"
        data-aos="fade-up"
        data-aos-duration="800"
        data-aos-delay="750"
      >
        <a class="button button-primary button-lg" id="reelTrigger" role="button" href="#reel">{homeData.reelButtonLabel}</a>
      </div>
    </div>

    <section id="reel" class="reel-section" aria-hidden="true">
      <div class="reel-shell">
        <div class="reel-player" id="reelTarget"></div>
      </div>
    </section>
  </section>

  <div class="marquee-wrapper" data-marquee-direction="left" data-marquee-pause="true">
    <div class="marquee-track">
      {homeData.marqueeItems.map((item) => (
        <>
          <span>{item}</span><span class="text-accent">•</span>
        </>
      ))}
    </div>
  </div>
</BaseLayout>
