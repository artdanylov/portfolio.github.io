---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveThumbnailUrls } from '../utils/media';

const articles = (await getCollection('articles'))
  .filter((a) => import.meta.env.DEV || a.data.publishing.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const ogImage = articles[0]?.data.coverImage ? resolveThumbnailUrls(articles[0].data.coverImage).staticUrl : undefined;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<BaseLayout
  title="Blog - ArtDanylov"
  description="Notes on 3D animation, rigging, Houdini, and pipeline by Artem Danylov."
  image={ogImage}
  preloadImage={ogImage}
  activeNav="blog"
>
  <section class="page-header">
    <div class="wrap">
      <h1 class="page-header-title page-hero-title text-gradient-brand hero-anim">
        BLOG
      </h1>
      <p class="page-header-lead copy-wide text-muted">
        Notes on animation, rigging and the pipeline — classes, Houdini experiments and small discoveries.
      </p>
    </div>
  </section>

  <section class="page-section-listing">
    <div class="wrap-fluid wrap-padded blog-container blog-max-lg">
      <div class="page-section-spacer"></div>
      <div class="blog-grid-4">
        {articles.map((article, index) => {
          const thumb = resolveThumbnailUrls(article.data.coverImage);
          const isAboveFold = index < 3;
          return (
            <article class="blog-card">
              <a
                class="blog-card-media"
                href={`/articles/${article.id}.html`}
                aria-label={`Read ${article.data.title}`}
              >
                <img
                  src={thumb.staticUrl}
                  data-static-src={thumb.staticUrl}
                  data-anim-src={thumb.animUrl || undefined}
                  alt={article.data.title}
                  width="640"
                  height="360"
                  loading={isAboveFold ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  decoding={index === 0 ? 'sync' : 'async'}
                />
              </a>
              <div class="blog-card-body">
                <div class="card-head-center">
                  <p class="blog-card-meta no-mb">
                    {formatDate(article.data.date)}
                  </p>
                  {import.meta.env.DEV && (
                    <div class="dev-actions">
                      {!article.data.publishing.published && <span class="draft-badge">Draft</span>}
                      <a
                        class="button button-sm button-ghost button-edit"
                        href={`/keystatic/collection/articles/item/${article.id}`}
                        target="_blank"
                        rel="noopener"
                      >
                        Edit
                      </a>
                    </div>
                  )}
                </div>
                <h3 class="blog-card-title">
                  <a href={`/articles/${article.id}.html`}>{article.data.title}</a>
                </h3>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
