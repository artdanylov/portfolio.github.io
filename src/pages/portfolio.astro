---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveThumbnailUrls } from '../utils/media';
import { getOrderedWorks } from '../utils/works';

const works = await getOrderedWorks();
const ogImage = works[0]?.data.thumbnail ? resolveThumbnailUrls(works[0].data.thumbnail).staticUrl : undefined;
---

<BaseLayout
  title="Portfolio - Artem Danylov"
  description="Animation, rigging and cinematics for games by Artem Danylov."
  image={ogImage}
  preloadImage={ogImage}
  activeNav="portfolio"
>
  <section class="page-header page-header-flex">
    <div class="wrap">
      <h1 class="page-header-title page-hero-title text-gradient-brand hero-anim">
        PORTFOLIO
      </h1>
      <p class="page-header-lead copy-wide text-muted">
        Animation, rigging and cinematics for games. Click any thumbnail to open the full breakdown.
      </p>
    </div>
  </section>

  <section class="page-section-listing">
    <div class="wrap-fluid wrap-padded blog-container blog-max-full">
      <div class="page-section-spacer"></div>
      <div class="pf-grid">
        {works.map((work, index) => {
          const thumb = resolveThumbnailUrls(work.data.thumbnail);
          const isAboveFold = index < 4;
          return (
            <article class="pf-card">
              <a
                class="pf-thumb"
                href={`/works/${work.id}.html`}
                aria-label={`Open ${work.data.title}`}
              >
                <img
                  src={thumb.staticUrl}
                  data-static-src={thumb.staticUrl}
                  data-anim-src={thumb.animUrl || undefined}
                  alt={`${work.data.title} thumbnail`}
                  width="640"
                  height="360"
                  loading={isAboveFold ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  decoding={index === 0 ? 'sync' : 'async'}
                />
              </a>
              <div class="pf-meta">
                <div class="card-head">
                  <h3 class="pf-title no-mb">{work.data.title}</h3>
                  {import.meta.env.DEV && (
                    <div class="dev-actions">
                      {!work.data.publishing.published && <span class="draft-badge">Draft</span>}
                      <a
                        class="button button-sm button-ghost button-edit"
                        href={`/keystatic/collection/works/item/${work.id}`}
                        target="_blank"
                        rel="noopener"
                      >
                        Edit
                      </a>
                    </div>
                  )}
                </div>
                <p class="pf-sub">{work.data.cardSubtitle}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
