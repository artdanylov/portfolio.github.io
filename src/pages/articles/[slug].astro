---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveThumbnailUrls } from '../../utils/media';

export async function getStaticPaths() {
  const articles = (await getCollection('articles'))
    .filter((a) => import.meta.env.DEV || a.data.publishing.published)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return articles.map((article, index) => ({
    params: { slug: article.id },
    props: {
      article,
      prevArticle: index < articles.length - 1 ? articles[index + 1] : null,
      nextArticle: index > 0 ? articles[index - 1] : null,
    },
  }));
}

const { article, prevArticle, nextArticle } = Astro.props;
const { Content } = await render(article);
const ogImage = article.data.coverImage ? resolveThumbnailUrls(article.data.coverImage).staticUrl : undefined;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<BaseLayout
  title={`${article.data.title} - ArtDanylov`}
  description={`${article.data.title} — notes on 3D animation, rigging and pipeline by Artem Danylov.`}
  image={ogImage}
  ogType="article"
  activeNav="blog"
>
  <section class="page-header-article">
    <div class="wrap">
      <div class="wrap-narrow">
        <div class="meta-bar">
          <a class="pf-proj-back no-mb" href="/blog.html">← All posts</a>
          {import.meta.env.DEV && (
            <div class="dev-actions">
              {!article.data.publishing.published && <span class="draft-badge">Draft</span>}
              <a
                class="button button-sm button-ghost"
                href={`/keystatic/collection/articles/item/${article.id}`}
                target="_blank"
                rel="noopener"
              >
                Edit in Keystatic
              </a>
            </div>
          )}
        </div>
        <h1 class="page-hero-title-sm">{article.data.title}</h1>
        <p class="text-small text-muted no-mb">{formatDate(article.data.date)}</p>
      </div>
    </div>
  </section>

  <section class="page-section-body">
    <div class="wrap-fluid wrap-padded">
      <div class="article-flow">
        <Content />
      </div>
    </div>
  </section>

  <section class="page-section-body">
    <div class="wrap">
      <div class="wrap-reading">
        <nav class="article-pager">
          {prevArticle && (
            <a href={`/articles/${prevArticle.id}.html`}>
              <span>Previous</span>
              {prevArticle.data.title}
            </a>
          )}
          {nextArticle && (
            <a class="pager-next" href={`/articles/${nextArticle.id}.html`}>
              <span>Next</span>
              {nextArticle.data.title}
            </a>
          )}
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>
